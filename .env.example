# Optional: accounts and cloud backup of saved calculations, on Neon.
# The app is fully functional without these (local-first). Set all three to
# switch on registration, sign-in and backup. Copy this file to .env.local.
# These are secrets: never commit them and never prefix them with NEXT_PUBLIC_.
#
# 1. Create a Neon project and enable Auth on its branch (Neon Console > Auth).
# 2. Run db/migrations/0001_init.sql against the database.
# 3. Fill in the values below.

# Pooled connection string from the Neon Console (Connect > Pooled connection).
DATABASE_URL=

# Auth URL from the Neon Console (Auth > Configuration).
NEON_AUTH_BASE_URL=

# Signs the session cookie. At least 32 characters: `openssl rand -base64 32`.
NEON_AUTH_COOKIE_SECRET=
